<div class="movie-detail-container card-box" style="max-width: 760px; margin: 30px auto; padding: 32px; border: 1px solid #e7e5e4; border-radius: 14px; background: #fff; box-shadow: 0 4px 12px rgba(41, 37, 36, 0.05);">
  <!-- 動画タイトル -->
  <h2 style="color: #0f172a; margin-top: 0; border-bottom: 2px solid #b45309; padding-bottom: 12px; font-size: 22px;">
    <%= @movie.movietitle %>
  </h2>
  
  <!-- YouTube埋め込み -->
  <% if @movie.link.present? && find_youtube_url(@movie.link).present? %>
    <div style="margin: 22px 0; border-radius: 10px; overflow: hidden; box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);">
      <iframe width="100%" height="390" 
              src="https://www.youtube.com/embed/<%= find_youtube_url(@movie.link) %>" 
              frameborder="0" allowfullscreen style="width: 100%; display: block;">
      </iframe>
    </div>
  <% end %>

  <!-- 投稿者 ＆ 見どころ -->
  <div style="margin: 24px 0; line-height: 1.8; color: #44403c;">
    <p style="margin: 6px 0;"><strong>投稿者：</strong><%= @movie.user.email if @movie.user.present? %></p>
    <div style="margin-top: 16px; padding: 14px 18px; background: #fef3c7; border-left: 4px solid #b45309; border-radius: 4px; border: 1px solid #fde68a; border-left-width: 4px;">
      <strong style="color: #78350f; font-size: 14px;">見どころ・楽曲紹介</strong>
      <div style="margin-top: 6px; color: #292524; line-height: 1.7;"><%= simple_format(@movie.point) %></div>
    </div>
  </div>

  <!-- 気になるボタン ＆ アクションリンク -->
  <div style="margin-top: 30px; padding-top: 20px; border-top: 1px solid #e7e5e4; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px;">
    <div>
      <% if user_signed_in? %>
        <% if current_user.already_movie_liked?(@movie) %>
          <%= button_to movie_movie_likes_path(@movie), method: :delete, style: "background: #fee2e2; border: 1px solid #fca5a5; color: #dc2626; padding: 6px 16px; border-radius: 20px; cursor: pointer; font-size: 13px; font-weight: bold;" do %>
            保存済み (<%= @movie.movie_likes.count %>)
          <% end %>
        <% else %>
          <%= button_to movie_movie_likes_path(@movie), method: :post, style: "background: #f5f5f4; border: 1px solid #d6d3d1; color: #57534e; padding: 6px 16px; border-radius: 20px; cursor: pointer; font-size: 13px; font-weight: bold;" do %>
            気になる (<%= @movie.movie_likes.count %>)
          <% end %>
        <% end %>
      <% else %>
        <%= link_to new_user_session_path, style: "background: #f5f5f4; border: 1px solid #d6d3d1; color: #a8a29e; padding: 6px 16px; border-radius: 20px; text-decoration: none; font-size: 13px; display: inline-flex;" do %>
          気になる (<%= @movie.movie_likes.count %>)
        <% end %>
      <% end %>
    </div>

    <div style="display: flex; align-items: center; gap: 12px;">
      <%= link_to "動画一覧へ戻る", movies_path, style: "color: #b45309; font-weight: 500; text-decoration: none; font-size: 14px;" %>

      <% if user_signed_in? && current_user.id == @movie.user_id %>
        <%= link_to "編集", edit_movie_path(@movie.id), class: "btn-action btn-edit" %>
        <%= button_to "削除", movie_path(@movie.id), method: :delete, data: { turbo_confirm: "本当にこの動画を削除しますか？" }, class: "btn-action btn-delete" %>
      <% end %>
    </div>
  </div>

  <!-- 動画コメントエリア -->
  <div style="margin-top: 40px; padding-top: 25px; border-top: 2px dashed #d6d3d1;">
    <h3 style="color: #0f172a; margin-top: 0; font-size: 18px;">
      感想・コメント（<%= @movie.movie_comments.count %>件）
    </h3>

    <div style="display: flex; flex-direction: column; gap: 12px; margin-top: 15px; margin-bottom: 25px;">
      <% if @movie.movie_comments.present? %>
        <% @movie.movie_comments.each do |c| %>
          <div style="background: #fafaf9; border: 1px solid #e7e5e4; border-radius: 8px; padding: 12px 16px; display: flex; justify-content: space-between; align-items: flex-start;">
            <div>
              <div style="font-size: 13px; color: #78716c; margin-bottom: 4px;">
                <strong><%= c.user.email.split('@').first %></strong> 
                <span style="font-size: 11px; margin-left: 6px;"><%= c.created_at.strftime('%Y/%m/%d %H:%M') %></span>
              </div>
              <div style="font-size: 14px; color: #292524; line-height: 1.5; white-space: pre-wrap;"><%= c.content %></div>
            </div>

            <% if user_signed_in? && current_user.id == c.user_id %>
              <%= button_to "削除", movie_movie_comment_path(@movie, c), method: :delete, data: { turbo_confirm: "コメントを削除しますか？" }, style: "background: none; border: none; color: #dc2626; font-size: 12px; cursor: pointer; padding: 0 4px; text-decoration: underline;" %>
            <% end %>
          </div>
        <% end %>
      <% else %>
        <p style="color: #a8a29e; font-size: 13px; margin: 0;">まだ感想はありません。</p>
      <% end %>
    </div>

    <% if user_signed_in? %>
      <div style="background: #fefce8; border: 1px solid #fef08a; border-radius: 8px; padding: 16px;">
        <%= form_with(model: [@movie, MovieComment.new], local: true) do |f| %>
          <div style="margin-bottom: 10px;">
            <%= f.text_area :content, rows: 3, placeholder: "演奏の感想や応援メッセージを入力してください", style: "width: 100%; box-sizing: border-box; padding: 10px; border: 1px solid #d6d3d1; border-radius: 6px; font-size: 14px; outline: none; background: #fff;" %>
          </div>
          <div style="text-align: right;">
            <%= f.submit "感想を送信", style: "background: #b45309; color: #fff; border: none; padding: 8px 18px; border-radius: 6px; font-size: 13px; font-weight: bold; cursor: pointer;" %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div style="background: #fafaf9; border: 1px dashed #d6d3d1; padding: 15px; border-radius: 8px; text-align: center; font-size: 13px; color: #78716c;">
        感想を投稿するには <%= link_to "ログイン", new_user_session_path, style: "color: #b45309; font-weight: bold;" %> してください。
      </div>
    <% end %>
  </div>

</div>